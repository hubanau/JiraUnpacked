# Copy to .env and fill in. .env is gitignored; these values must not be committed.
#
# Generate the two keys (any shell with openssl):
#   JWT_SIGNING_KEY      openssl rand -base64 48
#   TOKEN_PROTECTION_KEY openssl rand -base64 32     <- must decode to exactly 32 bytes
#
# The app refuses to start outside Development if either is missing, or if either is the value
# committed in appsettings.Development.json. That is deliberate: a dev key still mints valid
# tokens and still decrypts stored Jira tokens, so the failure it prevents is invisible.

JWT_SIGNING_KEY=
TOKEN_PROTECTION_KEY=

# Public address the app is reached at. It goes into password-reset links, so it must match
# where users actually browse. Defaults to the local stack.
APP_BASE_URL=http://localhost:8080

# Seeded admin. This account mints the invite codes that registration requires, so without it
# nobody can sign up. Must satisfy the password policy: 12+ chars, upper, lower, digit, symbol.
ADMIN_EMAIL=admin@jiraunpacked.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
